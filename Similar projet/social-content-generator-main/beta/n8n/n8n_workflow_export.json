{
  "name": "Render & Post Pipeline POC",
  "nodes": [
    {
      "name": "Read CSV",
      "type": "ReadBinaryFile",
      "parameters": { "filePath": "/data/data.csv" }
    },
    {
      "name": "For Each Row",
      "type": "SplitInBatches",
      "parameters": { "batchSize": 1 }
    },
    {
      "name": "HTTP Trigger Upload",
      "type": "ExecuteCommand",
      "parameters": {
        "command": "python3 /app/render_video.py /data/{{ $json.rowFile }}"
      }
    },
    {
      "name": "Upload to TikTok (placeholder)",
      "type": "HTTPRequest",
      "parameters": {
        "url": "https://api.tiktok.com/upload/video/",
        "options": {}
      }
    }
  ]
}