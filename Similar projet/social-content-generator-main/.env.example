# Core Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# API Keys (for workflow)
PEXELS_API_KEY=
PIXABAY_API_KEY=
NUELINK_API_KEY=
NUELINK_ACCOUNT_ID=

# Authentication
N8N_USER_FOLDER="$HOME/n8n-data"
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_123

# Security
N8N_ENCRYPTION_KEY=
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true

# Execution
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Custom Paths
EXTERNAL_STORAGE_SSH_KEY=
S3_ENDPOINT=
S3_BUCKET=

# Google Sheets Configuration
export GOOGLE_CREDENTIALS='{"type":"service_account",...}'
GOOGLE_SHEET_ID=1tAf9Gb68v1_d7AuaaMNuHL7JpqPS7uDkflHbCtYcYz8
GOOGLE_SERVICE_ACCOUNT_PATH=./google_credentials.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive.readonly

# Database (PostgreSQL)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8nPassword123

# Redis (Queue mode)
QUEUE_BULL_REDIS_HOST=n8n-redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=0

# System Configuration
PREVIEW_BASE_URL=http://localhost:8080

# SoundCloud (Optional)
SOUNDCLOUD_CLIENT_ID=You need to have an active Artist Pro account to create an application.
TIKTOK_CLIENT_ID=
META_ACCESS_TOKEN=

# Logging
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# Timezone
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
